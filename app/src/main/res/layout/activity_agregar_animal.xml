<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:background="#21852A">

            <TextView
                android:id="@+id/btnVolverAgregar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Agregar animal"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Código -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:text="Código"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etCodigoAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:hint="Ej. 024"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Nombre (opcional)"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etNombreAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:hint="Ej. Lucero"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Tipo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Tipo de animal"
            android:textColor="#222222"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spTipoAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:paddingHorizontal="8dp" />

        <!-- Raza -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Raza"
            android:textColor="#222222"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spRazaAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:paddingHorizontal="8dp" />

        <!-- Peso -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Peso (kg)"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etPesoAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:hint="Ej. 450"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Sexo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Sexo"
            android:textColor="#222222"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spSexoAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:paddingHorizontal="8dp" />

        <!-- Fecha de nacimiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Fecha de nacimiento"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etFechaNacimiento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:hint="AAAA-MM-DD"
            android:inputType="date"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Potrero -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Potrero"
            android:textColor="#222222"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spPotreroAnimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:paddingHorizontal="8dp" />

        <!-- Observaciones -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="Observaciones (opcional)"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etObservacionAnimal"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="20dp"
            android:background="#F4F0F0"
            android:gravity="top"
            android:hint="Escribe una observación..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- Guardar -->
        <Button
            android:id="@+id/btnGuardarAnimal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#21852A"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
