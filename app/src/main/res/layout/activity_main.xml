<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#21852A">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AgroControl"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔  👤"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp">

            <!-- SALUDO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Hola, Ganadero 👋"
                android:textColor="#26352A"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Aquí tienes un resumen de tu finca"
                android:textColor="#666666"
                android:textSize="13sp" />

            <!-- TARJETAS PRINCIPALES: FILA 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAnimales"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="#91DF87"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🐄\nAnimales\n24 registrados"
                    android:textColor="#174B20"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnProduccion"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="#A8D9FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🥛\nProducción\n186 litros"
                    android:textColor="#174B20"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TARJETAS PRINCIPALES: FILA 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPotreros"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="#E7FF80"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🌱\nPotreros\n6 registrados"
                    android:textColor="#35512C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReproduccion"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="#F1B6B9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="❤️\nReproducción\n3 eventos"
                    android:textColor="#542020"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PENDIENTES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pendientes"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Ver todos →"
                    android:textColor="#21852A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- PENDIENTE 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="#E7FF80"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="🌱  Potrero 3\n      Fumigación pendiente · 03/10/2026"
                android:textColor="#35512C"
                android:textSize="12sp" />

            <!-- PENDIENTE 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="9dp"
                android:background="#E7FF80"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="🌱  Potrero 2\n      Necesita abono · 05/10/2026"
                android:textColor="#35512C"
                android:textSize="12sp" />

            <!-- PENDIENTE 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="9dp"
                android:background="#F1B6B9"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="🐄  Vaca 024\n      Inseminación programada · 02/10/2026"
                android:textColor="#542020"
                android:textSize="12sp" />

            <!-- REPORTES -->
            <TextView
                android:id="@+id/btnReportes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="#C9A8E5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📊  Ver reportes\nEstadísticas de tu finca"
                android:textColor="#342144"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- MENÚ INFERIOR FIJO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nInicio"
            android:textColor="#21852A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navFinanzas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💰\nFinanzas"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navAnimales"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐄\nAnimales"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navPotreros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🌱\nPotreros"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navMas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☰\nMás"
            android:textColor="#333333"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>