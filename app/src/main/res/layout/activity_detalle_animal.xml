<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#21852A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/btnVolverDetalle"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalle del animal"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Datos principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lucero"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCodigoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Código: 001"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSexoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hembra"
                android:textColor="#21852A"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Información del animal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Información del animal"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTipoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Tipo: Vaca"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRazaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Raza: Holstein"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPesoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Peso: 450 kg"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvFechaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Fecha de nacimiento: No registrada"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPotreroDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Potrero: No asignado"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvObservacionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Observaciones: Sin observaciones"
                android:textColor="#333333"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Botón de producción -->
        <Button
            android:id="@+id/btnProduccionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#21852A"
            android:text="🥛 Ver producción de leche"
            android:textColor="#FFFFFF" />

        <!-- Botón de reproducción -->
        <Button
            android:id="@+id/btnReproduccionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#21852A"
            android:text="❤️ Ver reproducción"
            android:textColor="#FFFFFF" />

        <!-- Botón de edición -->
        <Button
            android:id="@+id/btnEditarAnimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#21852A"
            android:text="Editar animal"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
