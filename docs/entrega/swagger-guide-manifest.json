{
  "title": "Guía de pruebas API — Swagger UI",
  "project": "AgroControl",
  "swaggerUrl": "http://localhost:3000/api/docs",
  "demoUser": "demo@agrocontrol.local",
  "sections": [
    {
      "id": "00",
      "kind": "intro",
      "title": "Autorización Bearer en Swagger",
      "screenshot": "00-swagger-authorize.png",
      "purpose": "Tras el login, el token JWT se registra con el botón Authorize para que todas las peticiones autenticadas envíen el header Authorization.",
      "steps": "POST /auth/login → copiar accessToken → Authorize → pegar token → Authorize → Close.",
      "expectedStatus": "Candado cerrado / autorizado",
      "androidScreen": "—"
    },
    {
      "id": "01",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "pathMatch": "/auth/register",
      "screenshot": "01-auth-register.png",
      "purpose": "Registrar un usuario nuevo con su finca vacía.",
      "bodyKey": "register",
      "expectedStatus": "201",
      "androidScreen": "Registro"
    },
    {
      "id": "02",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "pathMatch": "/auth/login",
      "screenshot": "02-auth-login.png",
      "purpose": "Iniciar sesión y obtener accessToken y refreshToken.",
      "bodyKey": "loginDemo",
      "expectedStatus": "201",
      "androidScreen": "Login"
    },
    {
      "id": "03",
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "pathMatch": "/auth/refresh",
      "screenshot": "03-auth-refresh.png",
      "purpose": "Renovar el accessToken usando el refreshToken.",
      "bodyKey": "refresh",
      "expectedStatus": "201",
      "androidScreen": "—"
    },
    {
      "id": "04",
      "method": "GET",
      "path": "/api/v1/auth/me",
      "pathMatch": "/auth/me",
