{
  "info": {
    "name": "AgroControl API",
    "description": "Colección mínima para entrega. Base: /api/v1. Ejecutar Login demo primero.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@agrocontrol.local\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "GET me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Register (nueva finca vacía)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@ejemplo.local\",\n  \"password\": \"password123\",\n  \"nombre\": \"Usuario Prueba\",\n  \"fincaNombre\": \"Finca Prueba\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "GET summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/summary" }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "GET pull",
          "request": { "method": "GET", "url": "{{baseUrl}}/sync/pull" }
        },
        {
          "name": "POST push (empty)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"changes\": []\n}" },
            "url": "{{baseUrl}}/sync/push"
          }
        }
      ]
    },
    {
      "name": "Animals",
      "item": [
        {
          "name": "GET list",
          "request": { "method": "GET", "url": "{{baseUrl}}/animals" }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET pending",
          "request": { "method": "GET", "url": "{{baseUrl}}/tasks?status=PENDING" }
        },
        {
          "name": "PATCH complete (reemplazar id)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tasks/SEED_TASK_ID/complete",
            "description": "Sustituir SEED_TASK_ID por un id real de GET tasks"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "GET weekly",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/weekly?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "weekly"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        }
      ]
    }
  ]
}
